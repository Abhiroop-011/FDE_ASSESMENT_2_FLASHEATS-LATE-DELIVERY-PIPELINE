# Copy to config/.env (gitignored) to override config/config.yaml per environment.
# Real deployments would put the production Dispatch API URL and credentials here — never in code.
DISPATCH_API_URL=http://127.0.0.1:8000
DISPATCH_MAX_RETRIES=4
START_MOCK_API=true
# DISPATCH_API_KEY=replace-me
# MAX_DATA_AGE_DAYS=2
# WINDOW_DAYS=28
